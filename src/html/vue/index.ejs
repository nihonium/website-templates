<!DOCTYPE html>
<html>

<head>
    <meta charset="utf-8">
    <title>Vue TEST</title>
    <!-- Vue.js を読み込む -->
    <script src="https://cdn.jsdelivr.net/npm/vue/dist/vue.js"></script>
    <style>
        #app-1 .error {
            color: red;
        }

        #app-1 input {
            padding: 10px;
            border: 1px solid #000;
        }
    </style>
</head>

<body>
    <div id="app-1">
        <input type="text" v-model="message">
        <div class="error" v-if="error.require">必須項目です。</div>
        <div class="error" v-if="error.tooLong">長すぎます。</div>
    </div>
    <div id="app-101">
        <div v-text="message"></div>
        <div>{{ message }}</div>
    </div>
    <div id="app-102">
        <div v-text="message"></div>
        <div v-html="message"></div>
    </div>
    <div id="app-103">
        <input type="checkbox" @click="change" checked>
        <span v-show="seen">Hello!</span>
    </div>
    <div id="app-104">
        <input type="checkbox" @click="change" checked>
        <span v-if="seen2">Hello!</span>
    </div>
    <div id="app-105">
        <input type="checkbox" @click="change" checked>
        <span v-if="seen">Hello!</span>
        <span v-else>Bey!</span>
    </div>
    <div id="app-106">
        <input type="radio" name="app106-type" onclick="app106.type='A'" checked>
        <input type="radio" name="app106-type" onclick="app106.type='B'">
        <input type="radio" name="app106-type" onclick="app106.type='C'">
        <span v-if="type == 'A'">おはよう</span>
        <span v-else-if="type == 'B'">こんにちは</span>
        <span v-else>さようなら</span>
    </div>
    <div id="app-107">
        <ul>
            <li v-for="color in colorList">{{color}}</li>
        </ul>
    </div>

    <script>
        var app1 = new Vue({
            el: '#app-1',
            watch: {
                message: function (v, oldVal) {
                    this.error.require = (v.length < 1) ? true : false;
                    this.error.tooLong = (v.length > 5) ? true : false;
                }
            },
            data: {
                message: 'Hello',
                error: {
                    require: false,
                    tooLong: false
                }
            }
        });

        var app101 = new Vue({
            el: '#app-101',
            data: { message: 'Hello' }
        });

        var app102 = new Vue({
            el: '#app-102',
            data: { message: '<p>Hello!</p>' }
        });

        var app103 = new Vue({
            el: '#app-103',
            data: {seen: true},
            methods: {
                change: function(e) {
                    this.seen = e.target.checked;
                }
            }
        });

        var app104 = new Vue({
            el: '#app-104',
            data: {seen2: true},
            methods: {
                change: function(e) {
                    this.seen2 = e.target.checked;
                }
            }
        });

        var app105 = new Vue({
            el: '#app-105',
            data: {seen: true},
            methods: {
                change: function(e) {
                    this.seen = e.target.checked;
                }
            }
        });

        var app106 = new Vue({
            el: '#app-106',
            data: { type: 'A' }
        });

        var app107 = new Vue({
            el: '#app-107',
            data: { colorList: ['Red', 'Green', 'Blue'] }
        });
    </script>

</body>

</html>